{
  "name": "mcp-gemini-ask",
  "version": "3.0.0",
  "description": "MCP server - ask Google Gemini, with a self-managed model list and fallback",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run typecheck && node esbuild.config.mjs",
    "start": "node dist/mcp.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && npm run test:run",
    "test:run": "node --import ./test/support/register.mjs --test \"test/**/*.test.ts\"",
    "style": "node scripts/restyle.mjs",
    "live": "node scripts/live-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
