{
  "name": "mcp-gemini-ask",
  "version": "3.0.0",
  "description": "MCP server - ask Google Gemini, with self-managed model list and fallback",
  "type": "module",
  "main": "dist/mcp.js",
  "bin": {
    "mcp-gemini-ask": "dist/mcp.js"
  },
  "scripts": {
    "start": "node dist/mcp.js",
    "dev": "node src/mcp.js",
    "build": "esbuild src/mcp.js --bundle --platform=node --format=esm --target=node20 --outfile=dist/mcp.js --minify --legal-comments=none --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "test": "node test/unit.js && node test/integration.js src && node test/integration.js dist",
    "live": "node test/live.js dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=20"
  }
}
